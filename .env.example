# Get this from @BotFather on Telegram
TELEGRAM_TOKEN=

# Postgres connection string for production. Leave empty for local testing —
# the bot will automatically use a local SQLite file (remidionak.local.db) instead.
DATABASE_URL=

# Any random string, used to build the webhook URL path so only Telegram can hit it
WEBHOOK_SECRET=change-me

# Any random string, protects /tick and /set_webhook from being called by strangers
APP_SECRET=change-me-too

# Your public Render URL, e.g. https://remidionak.onrender.com (set after first deploy)
BASE_URL=

# Set to "polling" to run locally without a public webhook URL (for testing only)
RUN_MODE=
